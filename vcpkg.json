{
  "name": "pugo-oric",
  "version-string": "1.0.0",
  "dependencies": [
    "argparse",
    "boost-algorithm",
    "boost-circular-buffer",
    "boost-uuid",
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
